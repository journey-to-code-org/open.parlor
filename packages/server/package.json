{
  "name": "@open-parlor/server",
  "version": "0.1.0",
  "private": true,
  "description": "The spades server: family tables over the rooms kit, and the web app.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json && CARDROOM_BOT_DELAY=500 node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@journey-to-code/decks": "^0.1.0",
    "@journey-to-code/games": "^0.1.38",
    "@journey-to-code/palace": "^0.1.0",
    "@journey-to-code/physics": "^0.1.2",
    "@journey-to-code/relay": "^0.1.0",
    "@journey-to-code/rooms": "^0.1.0",
    "@journey-to-code/rules": "^0.1.0",
    "@open-parlor/courses": "*",
    "@open-parlor/wasm": "*",
    "@zubra/actions": "^5.22.0",
    "@zubra/compiler": "^5.22.0",
    "@zubra/runtime": "^5.22.0",
    "@zubra/server": "^5.22.0",
    "@zubra/sync": "^5.22.0",
    "qrcode-generator": "^2.0.4",
    "web-push": "^4.0.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
