{
  "name": "@open-parlor/server",
  "version": "0.1.0",
  "private": true,
  "description": "The spades server: family tables over the rooms kit, and the web app.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json && CARDROOM_BOT_DELAY=500 NODE_ENV=development node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@journey-to-code/chat": "^0.4.0",
    "@journey-to-code/decks": "^0.1.0",
    "@journey-to-code/games": "^0.1.41",
    "@journey-to-code/palace": "^0.1.0",
    "@journey-to-code/physics": "^0.1.2",
    "@journey-to-code/relay": "^0.1.0",
    "@journey-to-code/rooms": "^0.3.0",
    "@journey-to-code/rules": "^0.1.0",
    "@journey-to-code/symbology": "^0.2.0",
    "@open-parlor/courses": "*",
    "@open-parlor/wasm": "*",
    "@zubra/actions": "^6.0.5",
    "@zubra/compiler": "^6.0.5",
    "@zubra/runtime": "^6.0.5",
    "@zubra/server": "^6.0.5",
    "@zubra/sync": "^6.0.5",
    "web-push": "^4.0.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "typescript": "^5.6.0",
    "vitest": "^5.1.1"
  }
}
