<!--
  The games this parlor offers, as a page the server renders (src/pages.ts): every game is in the
  HTML before any script runs. The form is a plain GET form, so with JavaScript off "Show" asks the
  server for the filtered page; with it on, the list follows the fields as they change and the
  button isn't there. Built from the same zubra-ui components as the app.
-->
<script>
  import { hydrated } from '@zubra/runtime'
  import '@open-parlor/ui/zubra-ui/action-button.zb'
  import '@open-parlor/ui/zubra-ui/auto-grid.zb'
  import '@open-parlor/ui/zubra-ui/content-card.zb'
  import '@open-parlor/ui/zubra-ui/empty-state.zb'
  import '@open-parlor/ui/zubra-ui/select-field.zb'
  import '@open-parlor/ui/zubra-ui/status-badge.zb'
  import '@open-parlor/ui/zubra-ui/text-field.zb'

  const live = hydrated()
  const wanted = q.trim().toLowerCase()
  const shown = games.filter((game) => (kind === 'all' || game.kind === kind) && game.name.toLowerCase().includes(wanted))
  const count = shown.length === 1 ? '1 game' : `${shown.length} games`
</script>

<style>
  :host { display: block; }
  form { display: flex; flex-wrap: wrap; align-items: end; gap: 0.75rem 1rem; margin-bottom: 1rem; }
  form > * { flex: 1 1 12rem; }
  form > action-button { flex: none; }
  .count { margin: 0 0 0.75rem; color: var(--muted-foreground, #5d6470); font-size: 0.9rem; }
  .emoji { font-size: 1.4rem; line-height: 1; }
  .facts { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem; margin: 0; }
</style>

<games-page games={[]} kinds={[]} q:model="" kind:model="all">
  <form method="get" role="search" onsubmit={(event) => event.preventDefault()}>
    <text-field name="q" type="search" label="Name" value={q} onvaluechange={(event) => (q = event.detail)}></text-field>
    <select-field name="kind" label="Kind" options={kinds} value={kind} onvaluechange={(event) => (kind = event.detail)}></select-field>
    <action-button zb-if={!live} type="submit">Show</action-button>
  </form>
  <p class="count" aria-live="polite">{count}</p>
  <auto-grid zb-if={shown.length} min="13rem" gap="0.75rem">
    <zb-each items={shown} as="game" key={game.id}>
      <content-card heading={game.name} href={game.href}>
        <p class="facts">
          <span class="emoji" aria-hidden="true">{game.emoji}</span>
          <status-badge>{game.players}</status-badge>
          <status-badge zb-if={game.teams} variant="primary">Teams</status-badge>
        </p>
      </content-card>
    </zb-each>
  </auto-grid>
  <empty-state zb-else heading="No game by that name">Try fewer letters, or another kind.</empty-state>
</games-page>
