<!-- Copied from zubra-ui (0d2fdd0) components/toggle-switch.zb: https://github.com/journey-to-code-org/zubra-ui. Ours to edit.
     The parts are named switch-*: component styles sit in a layer, so any page class called .track or
     .text (Backgammon's board is a .track) would otherwise win over them and bend the switch out of shape. -->
<!--
  An on/off switch with a label and a description. A form control (submits "on" when checked).
  With `disabled`, or inside a disabled <fieldset>, it can't be switched and isn't submitted
  (zubra-ui#20; the same change is zubra-ui#21).
  @fires checkedchange - It was switched; `detail` is the new state.
-->
<script>
  import { effect, host } from '@zubra/runtime'

  // `disabled` set from code (el.disabled = true) also goes on the element as the attribute, which
  // is where the browser looks: it leaves a disabled control out of the form. A disabled
  // <fieldset> needs nothing here; the browser disables the button inside it too.
  const element = host()
  effect(() => element.toggleAttribute('disabled', disabled))

  function toggle() {
    checked = !checked
  }
</script>
<style>
  :host { display: block; }
  button { display: flex; align-items: center; gap: 0.9rem; width: 100%; padding: 0.75rem 0.9rem; border: 1px solid var(--border, #dde); border-radius: calc(var(--radius, 0.625rem) * 1.28); background: var(--card, #fff); color: inherit; font: inherit; text-align: left; cursor: pointer; }
  button:disabled { opacity: 0.55; cursor: not-allowed; }
  button:focus-visible { outline: 2px solid var(--ring, var(--primary, #36c)); outline-offset: 2px; }
  .switch-track { display: block; box-sizing: border-box; flex: none; width: 2.6rem; height: 1.5rem; padding: 0; border-radius: 999px; background: var(--switch-off, var(--border, #ccd)); box-shadow: inset 0 0 0 1px var(--switch-edge, #0002); position: relative; transition: background var(--duration-normal, 200ms); }
  .switch-track::after { content: ""; position: absolute; top: 0.2rem; left: 0.2rem; width: 1.1rem; height: 1.1rem; border-radius: 50%; background: white; box-shadow: 0 1px 2px #0003; transition: transform var(--duration-normal, 200ms); }
  [aria-checked=true] .switch-track { background: var(--primary, #36c); }
  [aria-checked=true] .switch-track::after { transform: translateX(1.1rem); }
  .switch-text { display: grid; flex: 1; min-width: 0; }
  small { color: var(--muted-foreground, #667); }
  .switch-extra { font-weight: 700; white-space: nowrap; }
  .switch-extra:empty { display: none; }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { transition-duration: 0s !important; animation-duration: 0s !important; animation-iteration-count: 1 !important; } }
</style>
<toggle-switch form-associated checked:model={false} disabled={false} label="" description="" extra="">
  <button type="button" role="switch" aria-checked={checked ? "true" : "false"} disabled={disabled} onclick={toggle}>
    <span class="switch-track"></span>
    <span class="switch-text"><span class="switch-label">{label}</span><small>{description}</small></span>
    <span class="switch-extra">{extra}</span>
  </button>
</toggle-switch>
