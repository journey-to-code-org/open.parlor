<!--
  A poker chip seen from above: its colour, the insets round its edge, an inner ring and the mark in
  the middle (its value, a suit, a star or a crown). Its size is its box's: give it a width.
  `edge` is one of stripes, blocks, dots, ring or plain; `mark` one of value, spade, heart,
  diamond, club, star, crown or none; `finish` clay, gloss or metal (see chip-design.ts). `label` is
  what it is read out as.
-->
<script>
  const GLYPHS = { spade: "♠︎", heart: "♥︎", diamond: "♦︎", club: "♣︎", star: "★︎", crown: "♛︎" }
  const said = value >= 1000 ? `${value / 1000}K` : String(value)
  const glyph = mark === "value" ? said : (GLYPHS[mark] ?? "")
  const small = mark === "value" && said.length > 2
  const DASH = { stripes: "4.5 8", blocks: "8.5 4", dots: "0.01 12.5" }
  const dash = DASH[edge] ?? ""
  const edged = edge === "stripes" || edge === "blocks" || edge === "dots"
  const width = edge === "dots" ? 7 : 10
</script>
<style>
  :host { display: inline-block; width: 64px; aspect-ratio: 1; }
  svg { display: block; width: 100%; height: 100%; overflow: visible; filter: drop-shadow(0 2px 3px rgba(0, 0, 0, 0.35)); }
  text { font: 700 30px Georgia, "Times New Roman", serif; font-variant-emoji: text; }
  text.glyph { font-family: "Apple Symbols", "Segoe UI Symbol", "Noto Sans Symbols 2", system-ui, sans-serif; font-size: 34px; }
  text.small { font-size: 22px; }
</style>
<poker-chip colour="#c8322b" inset="#f7f3ea" edge="stripes" mark="value" finish="clay" value={5} label="">
  <svg viewBox="0 0 100 100" role="img" aria-label={label || `${said} chip`}>
    <circle cx="50" cy="50" r="49" fill={colour} stroke="rgba(0,0,0,0.35)" stroke-width="1"></circle>
    <circle zb-if={edged} cx="50" cy="50" r="44" fill="none" stroke={inset} stroke-width={width} stroke-linecap={edge === "dots" ? "round" : "butt"} stroke-dasharray={dash} pathLength="100"></circle>
    <circle zb-if={edge === "ring"} cx="50" cy="50" r="44" fill="none" stroke={inset} stroke-width="4"></circle>
    <circle cx="50" cy="50" r="31" fill="none" stroke={inset} stroke-width="2"></circle>
    <circle cx="50" cy="50" r="49" fill="none" stroke="rgba(255,255,255,0.18)" stroke-width="1.5"></circle>
    <ellipse zb-if={finish === "gloss"} cx="38" cy="30" rx="26" ry="14" transform="rotate(-28 38 30)" fill="rgba(255,255,255,0.22)"></ellipse>
    <circle zb-if={finish === "metal"} cx="50" cy="50" r="47" fill="none" stroke="rgba(255,255,255,0.45)" stroke-width="2" stroke-dasharray="20 30" pathLength="100" transform="rotate(200 50 50)"></circle>
    <circle zb-if={finish === "metal"} cx="50" cy="50" r="47" fill="none" stroke="rgba(0,0,0,0.3)" stroke-width="2" stroke-dasharray="20 30" pathLength="100" transform="rotate(20 50 50)"></circle>
    <text zb-if={glyph} x="50" y="51" fill={inset} text-anchor="middle" dominant-baseline="central" class:glyph={mark !== "value"} class:small={small}>{glyph}</text>
  </svg>
</poker-chip>
