<!--
  A house's chat as a live document, and who else has the house's page open. It draws nothing of
  its own: the page around it draws the chat, from its events, and puts what it draws in its slot.

  `'use collection housechat'` makes the `let`s below the fields of the document
  `housechat/<doc>`, which the server writes and `connect()` brings to the page as it changes,
  and keeps on the device for when there's no connection. `member` is shared live with the other
  viewers of the document as presence, never stored; `peers()` is theirs.
  @fires {{ messages: unknown[], rev: number, filter: boolean }} chatchange - The chat changed; `detail` is the messages, the rev and whether crude words are covered.
  @fires {string[]} herechange - Who else has the page open changed; `detail` is their member ids, each once.
  @slot - The chat, drawn by the page.
-->
<script lang="ts">
  'use collection housechat'
  import { effect, emit } from '@zubra/runtime'
  import { peers, presence } from '@zubra/sync'

  // The document, as the server writes it. Never assigned here: only the server writes it.
  let messages: unknown[] = []
  let rev = 0
  let filter = false

  // Who this viewer is, for the others; and the others, one entry for each of their tabs, each
  // with this element's presence fields by name (`other.here`).
  let here = presence({ member: "" })
  let others = peers<{ here?: { member?: string } }>()

  effect(() => {
    here = { member }
  })
  // Plain copies out, read whole so a change anywhere inside is a change.
  effect(() => {
    emit("chatchange", { messages: JSON.parse(JSON.stringify(messages)), rev, filter })
  })
  effect(() => {
    emit("herechange", [...new Set(others.map((other) => other.here?.member ?? "").filter((id) => id && id !== member))])
  })
</script>
<style>
  :host { display: block; }
</style>
<house-chat-feed doc="" member="">
  <zb-slot></zb-slot>
</house-chat-feed>
