{
  "name": "@open-parlor/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && zubra build --embed ../ui/embed --out dist/embed --name cardroom && node scripts/embed-games.mjs --manifest dist/embed/games.json && node scripts/embed-titles.mjs && node scripts/openblog-component.mjs && node scripts/precache.mjs",
    "preview": "vite preview",
    "typecheck": "zubra types ../ui/src --dir .zubra/types --framework react && tsc -p tsconfig.json --noEmit && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run"
  },
  "dependencies": {
    "@journey-to-code/chat": "^0.4.0",
    "@journey-to-code/chat-ui": "^0.4.0",
    "@journey-to-code/decks": "^0.1.0",
    "@journey-to-code/games": "^0.1.43",
    "@journey-to-code/palace": "^0.1.0",
    "@journey-to-code/physics": "^0.1.2",
    "@journey-to-code/relay": "^0.1.0",
    "@journey-to-code/relay-ui": "^0.1.0",
    "@journey-to-code/rooms": "^0.3.0",
    "@journey-to-code/rules": "^0.1.0",
    "@journey-to-code/symbology": "^0.2.0",
    "@mediapipe/tasks-vision": "^0.10.35",
    "@open-parlor/courses": "*",
    "@vitejs/plugin-vue": "^6.0.11",
    "@zag-js/combobox": "^1.48.0",
    "@zag-js/vanilla": "^1.48.0",
    "@zubra/runtime": "^6.0.6",
    "@zubra/sync": "^6.0.6",
    "jsqr": "^1.4.0",
    "modern-screenshot": "^4.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "solid-js": "^1.9.19",
    "svelte": "^5.57.3",
    "three": "^0.187.0",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@zubra/compiler": "^6.0.6",
    "@zubra/unplugin": "^6.0.6",
    "svelte-check": "^4.7.8",
    "typescript": "^5.6.0",
    "vite": "^8.3.8",
    "vite-plugin-solid": "^2.11.16",
    "vitest": "^5.1.1"
  }
