{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "noEmit": true,
    "paths": {
      "@open-parlor/ui/*": [
        "./.zubra/types/__/ui/src/*",
        "../ui/src/*"
      ]
    },
    "types": [
      "@zubra/unplugin/client",
      "node"
    ],
    "allowArbitraryExtensions": true
  },
  "include": [
    "src",
    "test",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
