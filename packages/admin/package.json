{
  "name": "@open-parlor/admin",
  "version": "0.1.0",
  "private": true,
  "description": "The parlor's admin app: its host moderates tables, players and shared card designs. Angular (router, reactive forms), on Zubra components.",
  "scripts": {
    "zubra": "zubra build --lib ../ui/src --out zubra --name @open-parlor/admin-zubra",
    "dev": "npm run zubra && ng serve",
    "build": "npm run zubra && ng build",
    "typecheck": "npm run zubra && ngc -p tsconfig.app.json --noEmit"
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.6",
    "@journey-to-code/decks": "^0.1.0",
    "@zubra/runtime": "^5.22.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.8.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@zubra/compiler": "^5.22.0",
    "typescript": "~6.0.0"
  }
}
