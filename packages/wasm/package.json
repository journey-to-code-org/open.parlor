{
  "name": "@open-parlor/wasm",
  "version": "0.1.0",
  "private": true,
  "description": "Games compiled to WebAssembly. The first is a shooter on the open-source Doom engine (GPL-2.0), playing Freedoom.",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "node scripts/fetch-data.mjs && vite",
    "build": "node scripts/fetch-data.mjs && vite build",
    "preview": "vite preview",
    "engine": "node scripts/build-engine.mjs shooter",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.6.0",
    "vite": "^8.3.8",
    "vitest": "^2.1.0"
  }
}
