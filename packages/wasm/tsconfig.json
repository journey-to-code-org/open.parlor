{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "allowArbitraryExtensions": true,
    "resolveJsonModule": true,
    "types": ["svelte", "vite/client", "@zubra/unplugin/client", "node"],
    "paths": {
      "@open-parlor/ui/*": ["./.zubra/types/__/ui/src/*", "../ui/src/*"]
    }
  },
  "include": ["src", "host", "net", "wad", "test", "vite.config.ts", "vitest.config.ts"],
  // The stockroom page is Solid, and is checked on its own (tsconfig.market.json).
  "exclude": ["src/market/ui"]
}
